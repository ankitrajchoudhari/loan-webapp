PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://samiti:samiti_local_pw@localhost:5433/samiti?schema=public
# Practice (test) database — must be a DIFFERENT database. Leave empty to turn practice mode off.
TEST_DATABASE_URL=postgresql://samiti:samiti_local_pw@localhost:5433/samiti_test?schema=public
# Used only by `npm test` (wiped every run)
CI_DATABASE_URL=postgresql://samiti:samiti_local_pw@localhost:5433/samiti_ci?schema=public
CI_TEST_DATABASE_URL=postgresql://samiti:samiti_local_pw@localhost:5433/samiti_ci_practice?schema=public

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Website address(es) allowed to send changes, comma separated
APP_ORIGIN=http://localhost:3000

# Secret code asked on every admin login (and at one-time registration)
ADMIN_SECRET_CODE=choose-your-own-code
# Firebase project that verifies the admin's phone OTP / Google sign-in at registration
FIREBASE_PROJECT_ID=jaipur-comitte
# Optional: only these mobile numbers / Gmail addresses may register as admin (comma separated).
# Empty = anyone who passes the phone/Google check AND knows the secret code.
ADMIN_ALLOWED=

# Developer account (full access). Created/updated automatically when the server starts.
DEVELOPER_NAME=Developer
DEVELOPER_MOBILE=
DEVELOPER_DOB=
DEVELOPER_EMAIL=
SUPPORT_NOTIFY_URL=
PLATFORM_FEE_PAISE=1245

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
